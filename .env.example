AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_API_VERSION=2024-10-21
CHAT_DEPLOYMENT=gpt-4o-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Optional overrides
# SQLITE_PATH=data/claims_agent.db
# CHROMA_PATH=data/chroma
# RETRIEVAL_TOP_K=8
# MEMORY_WINDOW=6

# RAG over Azure AI Search + gpt-5-mini (all four required to enable /rag)
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<search-query-key>   # read-only query key is sufficient
AZURE_SEARCH_INDEX=<index-name>
RAG_CHAT_BASE_URL=https://<foundry-resource>.openai.azure.com/openai/v1
RAG_CHAT_API_KEY=<foundry-key>          # optional, falls back to AZURE_OPENAI_API_KEY
# RAG_CHAT_MODEL=gpt-5-mini
# RAG_REASONING_EFFORT=low
# RAG_TOP_K=4

# Optional: host port for docker compose (default 8000)
# HOST_PORT=80
